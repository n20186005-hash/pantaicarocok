---
/** Design contract: an asymmetric real-photo hero, teal chart annotations, editorial columns, and practical guidance. */
import { content, type Lang } from "../data/content";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
interface Props { lang: Lang; }
const { lang } = Astro.props; const t = content[lang]; const isId = lang === "id"; const homePath = isId ? "/" : "/en/";
const ids = isId ? { about: "tentang", visit: "kunjungan", transport: "transportasi", facilities: "fasilitas", around: "sekitar", map: "peta" } : { about: "about", visit: "visit", transport: "transport", facilities: "facilities", around: "around", map: "map" };
const sourceLinks = t.references.links as readonly (readonly [string, string])[];
const localBusiness = { "@context": "https://schema.org", "@type": ["TouristAttraction", "LocalBusiness"], name: "Pantai Carocok", address: { "@type": "PostalAddress", addressLocality: "Painan", addressRegion: "West Sumatra", postalCode: "25651", addressCountry: "ID" }, geo: { "@type": "GeoCoordinates", latitude: -1.3520247, longitude: 100.5670321 }, openingHoursSpecification: [{ "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Wednesday"], opens: "07:00", closes: "19:00" }, { "@type": "OpeningHoursSpecification", dayOfWeek: ["Tuesday", "Thursday"], opens: "07:30", closes: "19:00" }, { "@type": "OpeningHoursSpecification", dayOfWeek: "Friday", opens: "08:00", closes: "19:00" }, { "@type": "OpeningHoursSpecification", dayOfWeek: ["Saturday", "Sunday"], opens: "07:00", closes: "19:30" }], aggregateRating: { "@type": "AggregateRating", ratingValue: 4.5, reviewCount: 8349, bestRating: 5, worstRating: 1 } };
const faqPage = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: t.faq.items.map((item) => ({ "@type": "Question", name: item.q, acceptedAnswer: { "@type": "Answer", text: item.a } })) };
---
<SiteHeader lang={lang} homePath={homePath} />
<main id="main">
  <section class="hero" aria-labelledby="hero-title"><div class="hero-photo" role="img" aria-label="Pantai Carocok and its offshore islands"></div><div class="hero-scrim"></div><img class="hero-chart" src="/manus-storage/pantai-carocok-chart-texture_afa6faef.png" alt="" />
    <div class="shell hero-layout"><div class="hero-copy"><p class="eyebrow eyebrow--light">{t.hero.eyebrow}</p><h1 id="hero-title">{t.hero.title.split("\n").map((line) => <>{line}<br /></>)}</h1><p class="hero-lead">{t.hero.lead}</p><div class="hero-actions"><a class="button button--warm" href={`#${ids.visit}`}>{t.hero.primary}<span aria-hidden="true">↓</span></a><a class="button button--ghost" href={`#${ids.map}`}>{t.hero.secondary}<span aria-hidden="true">↗</span></a></div><p class="photo-credit">{t.hero.photo}</p></div>
      <aside class="hero-facts" aria-label={isId ? "Informasi ringkas" : "At a glance"}><div class="fact-line"><span>{t.hero.ratingLabel}</span><strong>{t.hero.rating}</strong><small>{t.hero.reviews}</small></div><div class="fact-line"><span>{t.hero.categoryLabel}</span><strong>{t.hero.category}</strong></div><div class="fact-line"><span>{t.hero.locationLabel}</span><strong>{t.hero.location}</strong></div><p class="fact-note">{t.hero.note}</p></aside></div>
  </section>
  <section class="section orientation" id={ids.about} aria-labelledby="orientation-title"><div class="shell editorial-grid"><div class="section-intro"><p class="eyebrow">{t.orientation.kicker}</p><h2 id="orientation-title">{t.orientation.title}</h2></div><div class="wide-copy"><p class="lead-copy">{t.orientation.lead}</p><div class="fact-grid">{t.orientation.facts.map((fact) => <div><span>{fact.label}</span><strong>{fact.value}</strong></div>)}</div></div></div></section>
  <section class="section story-section" aria-labelledby="story-title"><div class="route-mark"><span>01</span><i></i></div><div class="shell story-grid"><div class="story-copy"><p class="eyebrow">{t.story.kicker}</p><h2 id="story-title">{t.story.title}</h2>{t.story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}<blockquote>{t.orientation.quote}</blockquote></div><div class="story-notes">{t.story.notes.map((note, index) => <article class="note-card"><span>{String(index + 1).padStart(2, "0")}</span><h3>{note.title}</h3><p>{note.text}</p></article>)}</div></div></section>
  <section class="section visit-section" id={ids.visit} aria-labelledby="visit-title"><div class="shell"><div class="visit-heading"><div><p class="eyebrow">{t.visit.kicker}</p><h2 id="visit-title">{t.visit.title}</h2></div><p>{t.visit.intro}</p></div><div class="visit-cards">{t.visit.cards.map((card, index) => <article class="visit-card"><span>{String(index + 1).padStart(2, "0")}</span><p>{card.label}</p><h3>{card.value}</h3><small>{card.text}</small></article>)}</div></div></section>
  <section class="section transport-section" id={ids.transport} aria-labelledby="transport-title"><div class="shell transport-grid"><div class="section-intro"><p class="eyebrow">{t.transport.kicker}</p><h2 id="transport-title">{t.transport.title}</h2><p>{t.transport.intro}</p></div><div class="transport-list">{t.transport.options.map((option, index) => <article><span>0{index + 1}</span><div><h3>{option.title}</h3><p>{option.text}</p></div></article>)}</div></div></section>
  <section class="section facility-section" id={ids.facilities} aria-labelledby="facilities-title"><div class="shell facility-layout"><div class="facility-art"><img src="/manus-storage/pantai-carocok-coastal-notes_24ecd47a.png" alt="" /></div><div><p class="eyebrow">{t.facilities.kicker}</p><h2 id="facilities-title">{t.facilities.title}</h2><p class="lead-copy">{t.facilities.intro}</p><div class="facility-list">{t.facilities.items.map((item) => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></div></section>
  <section class="section around-section" id={ids.around} aria-labelledby="around-title"><div class="shell around-grid"><figure class="shore-photo"><img src="/manus-storage/pantai-carocok-shore_9da8f9bc.jpg" alt={isId ? "Pantai dan perahu di kawasan Carocok" : "Shore and boats in the Carocok area"} /><figcaption>{isId ? "Dokumentasi tepi Pantai Carocok · sumber: TripAdvisor, disajikan secara lokal." : "Carocok shoreline documentation · source: TripAdvisor, served locally."}</figcaption></figure><div class="around-copy"><p class="eyebrow">{t.around.kicker}</p><h2 id="around-title">{t.around.title}</h2><h3>{t.around.foodTitle}</h3><p>{t.around.foodText}</p><div class="nearby"><p class="eyebrow">{t.around.nearbyTitle}</p>{t.around.nearby.map((item, index) => <article><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div></div></div></section>
  <section class="section map-section" id={ids.map} aria-labelledby="map-title"><div class="shell map-layout"><div><p class="eyebrow eyebrow--light">{t.map.kicker}</p><h2 id="map-title">{t.map.title}</h2><p>{t.map.text}</p><a class="button button--warm" href="https://maps.app.goo.gl/QLHed3sAuh41ZDTp7" target="_blank" rel="noreferrer">{t.map.open}<span aria-hidden="true">↗</span></a></div><div class="map-frame"><iframe title="Pantai Carocok map" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7104.8853112148845!2d100.56226849678957!3d-1.3520247000000034!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2fd34d8532fc3f11%3A0x3769b900f1b811b6!2sPantai%20Carocok!5e1!3m2!1sid!2sid!4v1787032705803!5m2!1sid!2sid&hl=id" width="600" height="450" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></div></section>
  <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="shell faq-grid"><div class="section-intro"><p class="eyebrow">{t.faq.kicker}</p><h2 id="faq-title">{t.faq.title}</h2></div><div class="faq-list">{t.faq.items.map((item, index) => <details><summary><span>{String(index + 1).padStart(2, "0")}</span>{item.q}<b>+</b></summary><p>{item.a}</p></details>)}</div></div></section>
  <section class="section source-section" aria-labelledby="sources-title"><div class="shell source-grid"><div><p class="eyebrow">{t.references.kicker}</p><h2 id="sources-title">{t.references.title}</h2></div><div><p>{t.references.text}</p><ul>{sourceLinks.map(([label, href]) => <li><a href={href} target="_blank" rel="noreferrer">{label}<span aria-hidden="true">↗</span></a></li>)}</ul></div></div></section>
</main>
<SiteFooter lang={lang} homePath={homePath} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(localBusiness).replace(/</g, "\\u003c")}></script><script is:inline type="application/ld+json" set:html={JSON.stringify(faqPage).replace(/</g, "\\u003c")}></script>
