---
/** Design contract: legal content retains the guide’s calm editorial typography and honest tone. */
import { legalContent, content, type Lang } from "../data/content";
import SiteHeader from "./SiteHeader.astro"; import SiteFooter from "./SiteFooter.astro";
interface Props { lang: Lang; kind: "privacy" | "terms" | "cookies"; }
const { lang, kind } = Astro.props; const t = legalContent[lang][kind]; const labels = content[lang]; const homePath = lang === "id" ? "/" : "/en/"; const isCookies = kind === "cookies";
---
<SiteHeader lang={lang} homePath={homePath} alternatePath={lang === "id" ? `/en/${kind}/` : `/${kind}/`} /><main id="main" class="legal-main"><section class="legal-hero"><div class="shell"><p class="eyebrow eyebrow--light">Pantai Carocok Guide · {kind}</p><h1>{t.title}</h1><p>{t.lead}</p></div></section><section class="legal-content"><div class="shell legal-grid"><aside><a href={homePath}>← Pantai Carocok Guide</a><p>{labels.footer.statement}</p></aside><article>{t.sections.map(([heading, body]) => <section><h2>{heading}</h2><p>{body}</p></section>)}{isCookies && <form class="cookie-controls" data-cookie-controls><div><div><strong>{lang === "id" ? "Kuki yang diperlukan" : "Essential storage"}</strong><p>{lang === "id" ? "Selalu aktif untuk fungsi dasar." : "Always active for basic functions."}</p></div><span class="state-fixed">{lang === "id" ? "Aktif" : "Active"}</span></div><label><input type="checkbox" name="analytics" /><span><strong>Google Analytics</strong><small>{lang === "id" ? "Izinkan analitik penggunaan agregat." : "Allow aggregate usage analytics."}</small></span></label><label><input type="checkbox" name="preferences" /><span><strong>{lang === "id" ? "Preferensi bahasa" : "Language preference"}</strong><small>{lang === "id" ? "Simpan pilihan bahasa Anda secara lokal." : "Store your language choice locally."}</small></span></label><button class="button button--warm" type="submit">{lang === "id" ? "Simpan preferensi" : "Save preferences"}</button><p class="cookie-status" role="status" aria-live="polite"></p></form>}</article></div></section></main><SiteFooter lang={lang} homePath={homePath} />
{isCookies && <script is:inline>
(() => {
  const form = document.querySelector('[data-cookie-controls]');
  const analytics = form?.elements.namedItem('analytics');
  const preference = form?.elements.namedItem('preferences');
  const status = document.querySelector('.cookie-status');
  try {
    if (analytics) analytics.checked = localStorage.getItem('pantai-analytics') === 'granted';
    if (preference) preference.checked = localStorage.getItem('pantai-preferences') === 'granted';
  } catch {
    if (analytics) analytics.checked = false;
    if (preference) preference.checked = false;
  }
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    window.setPantaiAnalytics?.(analytics?.checked === true);
    let saved = false;
    try {
      localStorage.setItem('pantai-analytics', analytics?.checked ? 'granted' : 'denied');
      localStorage.setItem('pantai-preferences', preference?.checked ? 'granted' : 'denied');
      if (!preference?.checked) localStorage.removeItem('pantai-language');
      saved = true;
    } catch {}
    if (status) status.textContent = document.documentElement.lang === 'id'
      ? (saved ? 'Preferensi telah disimpan di perangkat ini.' : 'Pilihan berlaku untuk halaman ini, tetapi tidak dapat disimpan untuk kunjungan berikutnya.')
      : (saved ? 'Preferences have been saved on this device.' : 'Choice applies to this page, but could not be saved for later visits.');
  });
})();
</script>}
