---
/** Design contract: the footer closes the coastal narrative with transparent sourcing, not sales language. */
import { content, type Lang } from "../data/content";
interface Props { lang: Lang; homePath: string; }
const { lang, homePath } = Astro.props; const t = content[lang].footer;
const legal = lang === "id" ? { privacy: "/privacy/", terms: "/terms/", cookies: "/cookies/" } : { privacy: "/en/privacy/", terms: "/en/terms/", cookies: "/en/cookies/" };
---
<footer class="site-footer"><div class="shell footer-grid">
  <div class="footer-brand"><a class="brand brand--footer" href={homePath}><img src="/favicon.svg" alt="" width="50" height="50" /><span class="brand-copy"><strong>Pantai Carocok</strong><small>Visitor field guide</small></span></a><p>{t.statement}</p></div>
  <div class="footer-copy"><p>{t.sources}</p><p>{t.photo}</p></div>
  <nav class="footer-links" aria-label="Legal"><a href={legal.privacy}>{t.privacy}</a><a href={legal.terms}>{t.terms}</a><a href={legal.cookies}>{t.cookies}</a></nav>
</div><div class="shell footer-bottom"><span>{t.copyright}</span><span>Independent · non-profit · Painan</span></div></footer>
