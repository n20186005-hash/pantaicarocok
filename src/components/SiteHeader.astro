---
/** Design contract: navigation is a light, chart-like instrument bar—quiet, factual, and always legible. */
import { content, siteName, type Lang } from "../data/content";
interface Props { lang: Lang; homePath: string; }
const { lang, homePath } = Astro.props; const t = content[lang]; const alternate = lang === "id" ? "/en/" : "/";
---
<header class="site-header" data-site-header><div class="shell header-inner">
  <a class="brand" href={homePath} aria-label={`${siteName[lang]} — home`}><img src="/favicon.svg" alt="" width="52" height="52" /><span class="brand-copy"><strong>{siteName[lang].split(" — ")[0]}</strong><small>{siteName[lang].split(" — ")[1]}</small></span></a>
  <nav class="desktop-nav" aria-label="Primary navigation">{t.nav.map(([label, href]) => <a href={`${homePath}${href}`}>{label}</a>)}</nav>
  <a class="language-link" href={alternate} data-language-link>{t.langName}</a>
</div></header>
<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]"); const languageLink = document.querySelector<HTMLAnchorElement>("[data-language-link]");
  const setHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 12); setHeader(); window.addEventListener("scroll", setHeader, { passive: true });
  languageLink?.addEventListener("click", () => localStorage.setItem("pantai-language", languageLink.href.includes("/en/") ? "en" : "id"));
</script>
