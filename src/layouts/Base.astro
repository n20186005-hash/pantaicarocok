---
/**
 * Design contract: this layout protects the “Strait Chart” system—deep-water tones,
 * generous editorial spacing, and an uncluttered non-commercial reading experience.
 */
import "../styles/global.css";
import { siteName, type Lang } from "../data/content";

interface Props { lang: Lang; title: string; description: string; canonicalPath: string; alternatePath?: string; }
const { lang, title, description, canonicalPath, alternatePath } = Astro.props;
const siteUrl = Astro.site?.toString();
const canonical = siteUrl ? new URL(canonicalPath, siteUrl).toString() : undefined;
const alternateUrl = alternatePath ? new URL(alternatePath, siteUrl).toString() : undefined;
const ogImage = siteUrl ? new URL("/images/01-pantai-carocok-bay.jpg", siteUrl).toString() : "/images/01-pantai-carocok-bay.jpg";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#007f82" /><meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="apple-touch-icon" href="/favicon.svg" /><link rel="manifest" href="/site.webmanifest" />
    {canonical && <link rel="canonical" href={canonical} />}{canonical && <meta property="og:url" content={canonical} />}
    {canonical && alternateUrl && (<>
      <link rel="alternate" hreflang={lang} href={canonical} />
      <link rel="alternate" hreflang={lang === "id" ? "en" : "id"} href={alternateUrl} />
      <link rel="alternate" hreflang="x-default" href={lang === "id" ? canonical : alternateUrl} />
    </>)}
    <meta property="og:type" content="website" /><meta property="og:site_name" content={siteName[lang]} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:image" content={ogImage} />
    <title>{title}</title>
    <script is:inline>
      window.enablePantaiAnalytics = function () {
        if (document.querySelector("script[data-pantai-ga4]")) return;
        const script = document.createElement("script");
        script.async = true; script.src = "https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"; script.dataset.pantaiGa4 = "true"; document.head.appendChild(script);
        window.dataLayer = window.dataLayer || [];
        function gtag(){ window.dataLayer.push(arguments); }
        window.gtag = window.gtag || gtag;
        window.gtag("js", new Date()); window.gtag("config", "G-HXM22WWPKP", { anonymize_ip: true });
      };
      if (localStorage.getItem("pantai-analytics") === "granted") window.enablePantaiAnalytics();
    </script>
  </head>
  <body><a class="skip-link" href="#main">Skip to content</a><slot /></body>
</html>
